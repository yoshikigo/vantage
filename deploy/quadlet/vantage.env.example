# Copied to ~/.config/vantage/vantage.env by install.sh (an existing file is kept).
# Secrets are NOT here: they are Podman secrets (see README.md).
# After editing: systemctl --user restart vantage-backend

VANTAGE_DATABASE_URL=sqlite:////data/vantage.db
VANTAGE_COOKIE_SECURE=true
VANTAGE_SESSION_MAX_HOURS=12
VANTAGE_SESSION_IDLE_MINUTES=120
VANTAGE_DOWN_AFTER_FAILED_CYCLES=3
VANTAGE_LOG_LEVEL=INFO
# Keep equal to --storage.tsdb.retention.time in vantage-prometheus.container.
VANTAGE_PROMETHEUS_RETENTION=30d
# Host names the dashboard is opened by (install.sh fills these in).
VANTAGE_PUBLIC_HOSTS=@PUBLIC_HOSTS@
